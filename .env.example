# ── Aegis magic-link internal bridge ───────────────────────────────────────
#
# Used by src/lib/aegis-internal.ts when a manager clicks Approve/Deny in an
# email and the magic-link action endpoint dispatches the downstream workflow
# (employee notification, schedule fan-out) into the Aegis service.
#
# Both vars MUST also be set on Vercel; locally, add the same keys to your
# existing .env.local. The Aegis repo reads AEGIS_INTERNAL_SECRET as well —
# the values MUST match across repos for the bearer-auth gate to accept.

AEGIS_URL=                       # e.g. https://aegis.internal.quria.dev
AEGIS_INTERNAL_SECRET=           # long random secret, shared with Aegis repo
